# Reference for the inventory block in /etc/caddy/Caddyfile on the droplet.
# Caddy handles HTTPS and compression, Authelia handles the login, and the Node server
# (inventory.service) is on 3006. Anyone who gets past Caddy can edit the inventory, so keep
# forward_auth on. Match the Authelia address and URL to the other protected sites' blocks.

inventory.jkitchens.dev {
	encode zstd gzip

	forward_auth 127.0.0.1:9091 {
		uri /api/authz/forward-auth
		copy_headers Remote-User Remote-Groups Remote-Email Remote-Name
	}

	reverse_proxy 127.0.0.1:3006

	header {
		Strict-Transport-Security "max-age=31536000"
		Referrer-Policy strict-origin-when-cross-origin
	}
}
